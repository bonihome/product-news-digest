# AI provider
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=MiniMax-M2.7

AI_EXTRACT_PROVIDER=openai
AI_JUDGE_PROVIDER=openai
AI_WRITE_PROVIDER=openai

AI_TASK_TIMEOUT_MS=20000
AI_PROVIDER_RETRY_COUNT=2
PIPELINE_BRAND_CONCURRENCY=2
ANALYTICS_SERVER_PORT=8787

# Alert mail
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_TO=boni.sa@outlook.com
ALERT_EMAIL_FROM=your-sender@outlook.com
ALERT_SMTP_HOST=smtp.office365.com
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURE=false
ALERT_SMTP_USER=your-sender@outlook.com
ALERT_SMTP_PASS=replace-with-your-smtp-password-or-app-password
ALERT_EMAIL_SUBJECT_PREFIX=[Product News Pipeline]

# Weekly report mail
REPORT_EMAIL_ENABLED=true
REPORT_EMAIL_TO=boni.sa@outlook.com
REPORT_EMAIL_FROM=your-sender@outlook.com
REPORT_SMTP_HOST=smtp.office365.com
REPORT_SMTP_PORT=587
REPORT_SMTP_SECURE=false
REPORT_SMTP_USER=your-sender@outlook.com
REPORT_SMTP_PASS=replace-with-your-smtp-password-or-app-password
REPORT_EMAIL_SUBJECT_PREFIX=[Product News Weekly Report]
WEEKLY_REPORT_WINDOW_DAYS=7
